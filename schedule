      </div>

      <div style={{border:'1px solid #cbd5e1',borderRadius:'0 8px 8px 8px',padding:'12px',backgroundColor:'#fff',boxShadow:'0 1px 3px rgba(0,0,0,0.05)'}}>
        <table style={{width:'100%',borderCollapse:'collapse',fontSize:'12px',marginBottom:'10px'}}>
          <thead>
            <tr style={{backgroundColor:'#f1f5f9'}}>
              <th style={{padding:'7px 12px',textAlign:'left',border:'1px solid #e2e8f0',width:'70px'}}>時間</th>
              <th style={{padding:'7px 12px',textAlign:'left',border:'1px solid #e2e8f0',width:'180px'}}>患者番号（カンマ区切り）</th>
              <th style={{padding:'7px 12px',textAlign:'left',border:'1px solid #e2e8f0'}}>患者名プレビュー</th>
              <th style={{padding:'7px 12px',textAlign:'center',border:'1px solid #e2e8f0',width:'55px'}}>操作</th>

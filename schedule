/* ══════════════════════════════════════ BATH TAB */

function BathTab({bathTimes,updateBathSlot,addBathRow,removeBathRow,resetBathGroup,patients}){
  const[grpTab,setGrpTab]=useState('MON_THU');
  const[newTime,setNewTime]=useState('');
  const grpTimes=bathTimes[grpTab]||{};

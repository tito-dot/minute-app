const AM_SET    = new Set(['9:00','9:20','9:40','10:00','10:20','10:40','11:00','11:20','11:40','12:00']);
const PM_SET    = new Set(['13:20','13:40','14:00','14:20','14:40','15:00','15:20','15:40','16:00','16:20']);

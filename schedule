function getDayGroup(d){const w=d.getDay();if(w===1||w===4)return'MON_THU';if(w===2||w===5)return'TUE_FRI';if(w===3||w===6)return'WED_SAT';return null;}

function initPatients(){
  const ps={};
  for(let i=1;i<=43;i++) ps[i]={name:`${i}番`,maxSlots:9,assignedStaff:ALL_STAFF[(i-1)%ALL_STAFF.length],active:true};
  return ps;
}

/* ══════════════════════════════════════ SCHEDULING */

function getConsRuns(avail,order){
  const s=new Set(avail);const runs=[];let cur=[];
  for(const t of order){if(s.has(t))cur.push(t);else if(cur.length){runs.push(cur);cur=[];}}
  if(cur.length)runs.push(cur);return runs;
}

function firstOfLen(runs,len){for(const r of runs)if(r.length>=len)return r.slice(0,len);return null;}

function getStaffSlots(staff,earlyStaff,blocked){
  const isE=staff===earlyStaff,pmOrd=isE?EPM_ORDER:PM_ORDER;
  return{
    earlyList:isE?ERLY_ORD.filter(t=>!blocked.has(`${staff}_${t}`)):[],
    amList:!isE?AM_ORDER.filter(t=>!blocked.has(`${staff}_${t}`)):[],
    pmList:pmOrd.filter(t=>!blocked.has(`${staff}_${t}`)),
    pmOrder:pmOrd,
  };
}

function buildFullSchedule(grp,earlyStaff,blocked,patients,bathTimes){
  const activePs=Object.keys(patients).map(Number).filter(p=>patients[p].active);
  const pBath={};
  if(grp&&bathTimes[grp]){
    Object.entries(bathTimes[grp]).forEach(([t,pts])=>{
      (pts||[]).forEach(p=>{if(typeof p==='number'&&patients[p]?.active)pBath[p]=t;});
    });
  }
  const pTotal={};activePs.forEach(p=>pTotal[p]=0);
  const ns={};

  // Early shifts
  if(earlyStaff){
    getStaffSlots(earlyStaff,earlyStaff,blocked).earlyList.forEach(t=>{ns[`${earlyStaff}_${t}`]='早出';});
  }

  // Pass 1: 担当スタッフ必訪問（guaranteed first visit per patient)
  activePs.forEach(p=>{
    const pd=patients[p];
    if(!pd.assignedStaff||!ALL_STAFF.includes(pd.assignedStaff))return;
    const staff=pd.assignedStaff;
    const{amList,pmList,pmOrder}=getStaffSlots(staff,earlyStaff,blocked);
    const bt=pBath[p];
    const maxBlock=Math.min(3,pd.maxSlots-pTotal[p]);
    if(maxBlock<=0)return;
    const amFree=amList.filter(t=>!ns[`${staff}_${t}`]&&t!==bt);
    const pmFree=pmList.filter(t=>!ns[`${staff}_${t}`]&&t!==bt);
    const amR=getConsRuns(amFree,AM_ORDER),pmR=getConsRuns(pmFree,pmOrder);
    for(const len of[maxBlock,2,1]){
      if(len>maxBlock)continue;
      const b=firstOfLen(amR,len)||firstOfLen(pmR,len);
      if(b){b.forEach(t=>{ns[`${staff}_${t}`]=String(p);pTotal[p]++;});break;}
    }
  });

  // Pass 2: 全残スロットを患者 or 業務で充填
  ALL_STAFF.forEach(staff=>{
    const{amList,pmList,pmOrder}=getStaffSlots(staff,earlyStaff,blocked);
    function fill(allSlots,order){
      const unfilled=allSlots.filter(t=>!ns[`${staff}_${t}`]);
      const runs=getConsRuns(unfilled,order);
      for(const run of runs){
        let i=0;
        while(i<run.length){
          const time=run[i];
          const avail=activePs.filter(p=>pTotal[p]<patients[p].maxSlots&&pBath[p]!==time);
          if(!avail.length){ns[`${staff}_${time}`]='業務';i++;continue;}
          const myAss=avail.filter(p=>patients[p].assignedStaff===staff);
          const cand=[...myAss,...avail.filter(p=>patients[p].assignedStaff!==staff)]
            .sort((a,b)=>(patients[b].maxSlots-pTotal[b])-(patients[a].maxSlots-pTotal[a]))[0];
          const bt=pBath[cand],mb=Math.min(3,patients[cand].maxSlots-pTotal[cand]);
          let j=i,cnt=0;
          while(j<run.length&&cnt<mb&&run[j]!==bt){ns[`${staff}_${run[j]}`]=String(cand);pTotal[cand]++;j++;cnt++;}
          i=j;
        }
      }
    }
    fill(amList,AM_ORDER);fill(pmList,pmOrder);
  });
  return ns;
}

/* ══════════════════════════════════ PATIENT TAB */

function PatientTab({patients,updatePatient}){

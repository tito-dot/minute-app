      </div>

      <div style={{display:'flex',gap:'3px',marginBottom:'0'}}>
        {Object.entries(BATH_LABELS).map(([key,lbl])=>(
          <button key={key} onClick={()=>setGrpTab(key)}
            style={{padding:'7px 18px',backgroundColor:grpTab===key?'#1e3a8a':'#e2e8f0',color:grpTab===key?'#fff':'#374151',border:'1px solid #cbd5e1',borderBottom:grpTab===key?'1px solid #fff':'1px solid #cbd5e1',borderRadius:'6px 6px 0 0',cursor:'pointer',fontSize:'12px',fontWeight:'700'}}>

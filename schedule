        <div style={{display:'flex',gap:'8px',alignItems:'center',padding:'8px 10px',backgroundColor:'#f8fafc',borderRadius:'6px',border:'1px dashed #cbd5e1',flexWrap:'wrap'}}>
          <span style={{fontSize:'12px',fontWeight:'600',color:'#374151'}}>＋ 時間帯追加（入院患者）:</span>
          <select value={newTime} onChange={e=>setNewTime(e.target.value)}
            style={{padding:'5px 8px',border:'1px solid #d1d5db',borderRadius:'5px',fontSize:'12px'}}>

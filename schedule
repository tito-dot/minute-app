            <tr style={{backgroundColor:'#1e3a8a',color:'#fff'}}>
              <th style={{padding:'8px 10px',width:'48px',textAlign:'center'}}>番号</th>
              <th style={{padding:'8px 10px',textAlign:'left',minWidth:'100px'}}>患者名（編集可）</th>

                <td style={{padding:'4px 8px',border:'1px solid #e2e8f0'}}>
                  <input
                    key={`${grpTab}_${time}`}
                    defaultValue={(grpTimes[time]||[]).join(', ')}
                    onBlur={e=>updateBathSlot(grpTab,time,e.target.value)}
                    onKeyDown={e=>{if(e.key==='Enter')e.target.blur();}}
                    placeholder="例: 1, 5"
                    style={{width:'100%',padding:'4px 8px',border:'1px solid #d1d5db',borderRadius:'4px',fontSize:'12px',boxSizing:'border-box'}}
                  />
                </td>
                <td style={{padding:'5px 12px',border:'1px solid #e2e8f0',fontSize:'11px',color:'#374151'}}>
                  {(grpTimes[time]||[]).length>0
                    ?(grpTimes[time]).map(p=>patients[p]?.name||`${p}番`).join('・')
                    :<span style={{color:'#9ca3af'}}>（未設定）</span>}
                </td>
                <td style={{padding:'4px',textAlign:'center',border:'1px solid #e2e8f0'}}>
